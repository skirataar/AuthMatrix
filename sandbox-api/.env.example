# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite)
DATABASE_URL="file:./dev.db"

# Security Mode: 'vulnerable' or 'patched'
# Can also be overridden per-request via 'x-security-mode' header
DEFAULT_SECURITY_MODE=vulnerable

# JWT Configuration
JWT_SECRET=sandbox-super-secret-jwt-key-2026-audit-suite
JWT_EXPIRES_IN=1h
